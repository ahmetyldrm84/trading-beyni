# Bilgisayarda çalıştırırken: bu dosyayı .env adıyla kopyala ve doldur.
# GitHub'da çalışırken bu dosya kullanılmaz; değerler depo ayarlarındaki Secrets bölümüne girilir.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL="file:./trading-beyni.db"

# İsteğe bağlı
# OTO_TARAMA_DK=30          # otomatik tarama aralığı: 15, 20, 30 ya da 60
# GECE_YASAGI=00:30-08:00   # bu saatlerde (TR) otomatik tarama yok; kapatmak için: kapali
# BEKLE_BILDIRIMI=acik      # fırsat yokken tek satır "bekle" mesajı; susturmak için: kapali
# OTO_MIN_GUVEN=6           # otomatik kart eşiği (6-10)
# STOCK_AUTO=kapali         # NASDAQ otomatik taraması
